#!/usr/bin/expect -f
set timeout -1

spawn ros2 run physicalai_teleop teleop_keyboard

sleep 3            ;# ノードの起動を待つ
send "q"
sleep 0.3
for {set i 0} {$i <15} {incr i} {
    send "s"
    sleep 0.3
}
send "x"
sleep 1.0
send "c"
sleep 0.3
send "o"
sleep 0.3
send "c"
sleep 0.3
send "o"
sleep 0.3
send "e"
sleep 0.3
for {set i 0} {$i < 10} {incr i} {
    send "w"
    sleep 0.3
}
send "q"
sleep 0.3
for {set i 0} {$i < 15} {incr i} {
    send "s"
    sleep 0.3
}
send "x"
sleep 1.0
send "c"
sleep 0.3
send "o"
sleep 0.3
send "c"
sleep 0.3
send "o"
sleep 0.3
send "e"
sleep 0.3
for {set i 0} {$i < 10} {incr i} {
    send "s"
    sleep 0.3
}
send "q"
sleep 0.3
for {set i 0} {$i < 15} {incr i} {
    send "s"
    sleep 0.3
}
send "x"
sleep 1.0
send "c"
sleep 0.3
send "o"
sleep 0.3
send "c"
sleep 0.3
send "o"
sleep 1.0
send "\003"        ;# Ctrl+C で終了
expect eof

